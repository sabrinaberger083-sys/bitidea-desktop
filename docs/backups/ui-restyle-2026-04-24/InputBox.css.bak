.input-wrap {
  position: relative;
  padding: 14px 20px 20px;
  flex-shrink: 0;
  background: linear-gradient(180deg, transparent, rgba(15, 25, 50, 0.25) 40%);
}
.input-bar {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  gap: 10px;
  border: 1px solid var(--panel-border);
  border-radius: var(--r-lg);
  background: rgba(15, 25, 50, 0.30);
  padding: 8px 8px 8px 14px;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: border-color var(--t), box-shadow var(--t);
}
.input-bar:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(74, 158, 255, 0.15);
}
.input-bar textarea {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.55;
  padding: 6px 0;
  resize: none;
}
.input-bar textarea::placeholder {
  color: var(--ink-faint);
}

/* ── Drag-over state ──────────────────────────── */
.input-drag-over .input-bar {
  border-color: var(--accent-2);
}
.drop-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(74, 158, 255, 0.06);
  border: 2px dashed var(--accent-2);
  border-radius: var(--r-lg);
  color: var(--accent-2);
  font-size: 14px;
  font-weight: 600;
  pointer-events: none;
}

/* ── Attachment preview strip ─────────────────── */
.attach-preview-strip {
  max-width: 820px;
  margin: 0 auto 8px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  padding: 0 2px;
}
.attach-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 8px;
  background: rgba(120, 180, 255, 0.06);
  border: 1px solid var(--panel-border);
  border-radius: var(--r-md);
  font-size: 12px;
  color: var(--ink-dim);
  max-width: 180px;
}
.attach-thumb {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: var(--r-sm);
}
.attach-file-icon {
  font-size: 18px;
}
.attach-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.attach-remove {
  background: none;
  border: none;
  color: var(--ink-faint);
  cursor: pointer;
  font-size: 12px;
  padding: 0 2px;
  line-height: 1;
}
.attach-remove:hover {
  color: var(--danger);
}

/* ── Attach button ────────────────────────────── */
.attach-btn {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  padding: 4px;
  color: var(--ink-dim);
  transition: color var(--t-fast);
  flex-shrink: 0;
}
.attach-btn:hover:not(:disabled) {
  color: var(--accent-2);
}
.attach-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
