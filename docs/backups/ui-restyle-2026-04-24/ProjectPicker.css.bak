/* ── Project picker ──────────────────────────────────────── */

.project-picker {
  padding: 8px 14px;
  border-bottom: 1px solid var(--panel-border);
  flex-shrink: 0;
}

.project-picker-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  background: rgba(15, 25, 50, 0.2);
  border: 1px solid var(--panel-border);
  border-radius: var(--r-sm);
  color: var(--ink);
  font-size: 12px;
  padding: 6px 10px;
  cursor: pointer;
  transition: border-color var(--t);
  text-align: left;
}
.project-picker-toggle:hover {
  border-color: var(--accent);
}

.project-picker-icon {
  font-size: 14px;
  flex-shrink: 0;
  opacity: 0.7;
}

.project-picker-label {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-picker-arrow {
  font-size: 10px;
  opacity: 0.5;
  flex-shrink: 0;
}

/* ── Dropdown ────────────────────────────────────────────── */

.project-dropdown {
  position: absolute;
  left: 14px;
  right: 14px;
  z-index: 60;
  margin-top: 4px;
  background: var(--panel-solid);
  border: 1px solid var(--panel-border);
  border-radius: var(--r-sm);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  padding: 4px;
  max-height: 320px;
  overflow-y: auto;
}

.project-dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  text-align: left;
  background: transparent;
  border: none;
  color: var(--ink-dim);
  font-size: 12px;
  padding: 7px 10px;
  border-radius: var(--r-xs);
  cursor: pointer;
  transition: all var(--t-fast);
}
.project-dropdown-item:hover {
  background: rgba(74, 158, 255, 0.08);
  color: var(--ink);
}
.project-dropdown-item-active {
  background: rgba(74, 158, 255, 0.12);
  color: var(--accent-2);
}

.project-dropdown-icon {
  font-size: 13px;
  flex-shrink: 0;
  opacity: 0.6;
}

.project-dropdown-name {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project-dropdown-path {
  font-size: 10px;
  color: var(--ink-faint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 140px;
  flex-shrink: 0;
}

.project-dropdown-divider {
  height: 1px;
  background: var(--panel-border);
  margin: 4px 0;
}

.project-dropdown-new {
  color: var(--accent-2);
}
.project-dropdown-new:hover {
  color: var(--accent);
}

/* ── Inline rename ───────────────────────────────────────── */

.project-rename-input {
  width: 100%;
  background: rgba(15, 25, 50, 0.25);
  border: 1px solid var(--accent);
  border-radius: var(--r-xs);
  color: var(--ink);
  font-size: 12px;
  padding: 2px 6px;
  outline: none;
}

/* ── Delete button in dropdown ───────────────────────────── */

.project-dropdown-danger:hover {
  color: var(--danger) !important;
  background: rgba(239, 68, 68, 0.08) !important;
}
