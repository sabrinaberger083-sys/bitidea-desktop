/* ══════════════════════════════════════════════════════════
   AssistantPicker · Assistant selector in chat topbar
   ══════════════════════════════════════════════════════════ */

.assistant-picker {
  position: relative;
}

/* ── Trigger chip ─────────────────────────────────────── */
.assistant-picker-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  font-family: var(--font-sans);
  font-size: 12px;
  color: var(--ink-dim);
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: var(--r-md);
  cursor: pointer;
  transition: border-color var(--t), color var(--t), background var(--t);
  white-space: nowrap;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  user-select: none;
  line-height: 1.4;
}

.assistant-picker-chip:hover {
  border-color: var(--panel-border-strong);
  color: var(--ink);
}

.assistant-picker-chip.open {
  border-color: var(--accent);
  color: var(--ink);
}

.assistant-picker-chevron {
  font-size: 8px;
  opacity: 0.5;
  flex-shrink: 0;
  transition: transform var(--t-fast);
}

.assistant-picker-chip.open .assistant-picker-chevron {
  transform: rotate(180deg);
}

/* ── Dropdown ─────────────────────────────────────────── */
.assistant-picker-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  width: 280px;
  max-height: 400px;
  overflow-y: auto;
  background: var(--panel-solid);
  border: 1px solid var(--panel-border);
  border-radius: var(--r-lg);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 50;
  animation: assistantPickerIn 0.12s ease;
  display: flex;
  flex-direction: column;
  padding: 4px 0;
}

@keyframes assistantPickerIn {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Divider ──────────────────────────────────────────── */
.assistant-picker-divider {
  height: 1px;
  background: var(--panel-border);
  margin: 4px 0;
  flex-shrink: 0;
}

/* ── Items ────────────────────────────────────────────── */
.assistant-picker-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 7px 12px;
  font-size: 13px;
  color: var(--ink-dim);
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
  border: none;
  background: none;
  text-align: left;
  width: 100%;
}

.assistant-picker-item:hover {
  background: rgba(74, 158, 255, 0.06);
  color: var(--ink);
}

.assistant-picker-item.active {
  color: var(--accent);
}

.assistant-picker-item.active:hover {
  background: rgba(74, 158, 255, 0.08);
}

.assistant-picker-check {
  width: 14px;
  flex-shrink: 0;
  font-size: 10px;
  color: var(--accent);
  margin-top: 2px;
}

.assistant-picker-icon {
  flex-shrink: 0;
  font-size: 14px;
  line-height: 1.3;
}

.assistant-picker-item-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  flex: 1;
}

.assistant-picker-item-name {
  font-size: 13px;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assistant-picker-item-desc {
  font-size: 11px;
  color: var(--ink-faint);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── New assistant button ─────────────────────────────── */
.assistant-picker-new {
  display: flex;
  align-items: center;
  padding: 7px 12px 7px 34px;
  font-size: 12px;
  font-family: var(--font-sans);
  color: var(--accent);
  cursor: pointer;
  transition: background var(--t-fast), color var(--t-fast);
  border: none;
  background: none;
  text-align: left;
  width: 100%;
  white-space: nowrap;
}

.assistant-picker-new:hover {
  background: rgba(74, 158, 255, 0.08);
  color: var(--accent-2);
}
