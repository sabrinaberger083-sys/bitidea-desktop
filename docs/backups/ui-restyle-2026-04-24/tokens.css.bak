/* ══════════════════════════════════════════════════════════
   BITIDEA Desktop · Design Tokens
   Ported from the Web3 landing page (landing/index.html).
   Single source of truth — all components reference var(--*).
   ══════════════════════════════════════════════════════════ */

:root {
  /* ── Background / surface ───────────────────────── */
  --bg: #0A1028;
  --bg-2: #0E1830;
  --panel: rgba(15, 25, 50, 0.18);
  --panel-solid: #111B2E;
  --panel-border: rgba(120, 180, 255, 0.10);
  --panel-border-strong: rgba(120, 180, 255, 0.18);
  --border-glow: linear-gradient(135deg, rgba(74,158,255,0.3) 0%, rgba(125,211,252,0.08) 100%);
  --border-glow-subtle: linear-gradient(135deg, rgba(74,158,255,0.15) 0%, rgba(125,211,252,0.05) 100%);

  /* ── Text ───────────────────────────────────────── */
  --ink: #F1F5F9;
  --ink-dim: #94A3B8;
  --ink-faint: #64748B;

  /* ── Brand / accent ─────────────────────────────── */
  --accent: #4A9EFF;
  --accent-2: #7DD3FC;
  --accent-3: #A78BFA;
  --accent-purple-light: #C4B5FD;

  /* ── Semantic ───────────────────────────────────── */
  --success: #22c55e;
  --warning: #f59e0b;
  --danger: #ef4444;

  /* ── Effects ────────────────────────────────────── */
  --glow: 0 4px 24px rgba(74, 158, 255, 0.12), 0 12px 48px rgba(74, 158, 255, 0.06);
  --glow-cyan: 0 4px 20px rgba(125, 211, 252, 0.15);
  --grid-line: rgba(74, 158, 255, 0.02);

  /* ── Gradients ──────────────────────────────────── */
  --grad-brand: linear-gradient(135deg, #4A9EFF 0%, #7DD3FC 100%);
  --grad-title: linear-gradient(135deg, #F8FAFC 0%, #4A9EFF 50%, #7DD3FC 100%);
  --grad-skills: linear-gradient(135deg, #A78BFA 0%, #C4B5FD 100%);

  /* ── Typography ─────────────────────────────────── */
  --font-sans: 'Inter', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
  --font-zh: 'Noto Sans SC', 'Inter', -apple-system, system-ui, sans-serif;

  /* ── Radii ──────────────────────────────────────── */
  --r-xs: 4px;
  --r-sm: 6px;
  --r-md: 10px;
  --r-lg: 14px;
  --r-xl: 16px;
  --r-pill: 99px;

  /* ── Spacing scale (8pt grid) ───────────────────── */
  --s-1: 4px;
  --s-2: 8px;
  --s-3: 12px;
  --s-4: 16px;
  --s-5: 20px;
  --s-6: 24px;
  --s-8: 32px;
  --s-10: 40px;
  --s-12: 48px;
  --s-16: 64px;

  /* ── Transitions ────────────────────────────────── */
  --t-fast: 0.15s ease;
  --t: 0.2s ease;
  --t-slow: 0.3s ease;
}

/* ── Body default ─────────────────────────────────── */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body, #root { height: 100%; }
body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── Scrollbars (dark themed) ─────────────────────── */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: var(--panel-border);
  border-radius: var(--r-pill);
}
::-webkit-scrollbar-thumb:hover { background: var(--panel-border-strong); }

/* ── Global atmospheric background ────────────────── */
.bg-layer {
  position: fixed;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    radial-gradient(ellipse 130% 50% at 50% -5%, rgba(74, 158, 255, 0.35) 0%, transparent 65%),
    radial-gradient(ellipse 80% 60% at 10% 85%, rgba(167, 139, 250, 0.18) 0%, transparent 55%),
    radial-gradient(ellipse 70% 50% at 90% 75%, rgba(74, 158, 255, 0.14) 0%, transparent 55%),
    radial-gradient(ellipse 50% 30% at 50% 50%, rgba(30, 58, 138, 0.12) 0%, transparent 70%),
    linear-gradient(to top, rgba(6, 10, 20, 1) 0%, rgba(6, 10, 20, 0.7) 12%, transparent 35%),
    var(--bg);
}
.bg-grid {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(1.5px 1.5px at 15% 25%, rgba(255, 255, 255, 0.15), transparent),
    radial-gradient(1px 1px at 45% 12%, rgba(255, 255, 255, 0.10), transparent),
    radial-gradient(1.5px 1.5px at 75% 55%, rgba(255, 255, 255, 0.12), transparent),
    radial-gradient(1px 1px at 35% 75%, rgba(255, 255, 255, 0.08), transparent),
    radial-gradient(1px 1px at 85% 20%, rgba(255, 255, 255, 0.07), transparent),
    radial-gradient(1.5px 1.5px at 55% 85%, rgba(255, 255, 255, 0.10), transparent);
  background-size: 250px 250px;
  mask-image: none;
  -webkit-mask-image: none;
  animation: none;
}

/* ── Keyframes ────────────────────────────────────── */
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes titleGlow {
  from { filter: drop-shadow(0 0 24px rgba(74, 158, 255, 0.1)); }
  to { filter: drop-shadow(0 0 36px rgba(125, 211, 252, 0.15)); }
}

/* ── Link defaults ─────────────────────────────────── */
a { color: var(--accent-2); text-decoration: none; transition: color var(--t); }
a:hover { color: var(--accent); }

/* ── Selection ─────────────────────────────────────── */
::selection { background: rgba(74, 158, 255, 0.25); color: var(--ink); }
