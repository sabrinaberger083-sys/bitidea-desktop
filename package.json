{
  "name": "bitidea-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:windows:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar-win.ps1",
    "test:windows:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/smoke-sidecar-win.ps1",
    "build:windows:installer": "npm run build:windows:sidecar && npm run test:windows:sidecar && tauri build --bundles nsis --ci --no-sign",
    "build:windows:portable": "npm run build:windows:sidecar && npm run test:windows:sidecar && tauri build --no-bundle --ci && powershell -ExecutionPolicy Bypass -File scripts/package-portable-win.ps1",
    "dist:windows": "npm run build:windows:installer && npm run build:windows:portable",
    "dist:windows:installer": "npm run build:windows:installer",
    "dist:windows:portable": "npm run build:windows:portable"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.2",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
